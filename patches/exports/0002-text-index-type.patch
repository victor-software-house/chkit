+def _docs_table(indexes: list[dict[str, Any]]) -> Any:
+    return table(
+        database="app",
+        name="docs",
+        columns=[
+            {"name": "id", "type": "UInt64"},
+            {"name": "title", "type": "String"},
+            {"name": "body", "type": "String"},
+        ],
+        engine="MergeTree()",
+        primaryKey=["id"],
+        orderBy=["id"],
